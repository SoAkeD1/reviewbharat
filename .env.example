# Copy to .env and fill in. Never commit .env.

# Which OpenAI-compatible provider to use: bharatcode (default), groq, gemini, openrouter, custom
LLM_PROVIDER=bharatcode

# Set the key for the provider you chose (only one is needed)
BHARATCODE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides (custom provider needs both base URL and model)
LLM_MODEL=
LLM_BASE_URL=
LLM_MAX_TOKENS=

# Optional: raises GitHub rate limits / allows private repos
GITHUB_TOKEN=
PORT=3000
